# Copy to .env.local for local testing, and add the same values in
# Vercel -> Project Settings -> Environment Variables.
# Leave SUPABASE_* empty to run in DEMO mode (sample data, nothing saved,
# admin password "dinodemo").

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key works: the database only answers when DINO_DB_SECRET matches
# the hash stored in private.app_secret (see RLS policies). A service-role key
# also works (SUPABASE_SERVICE_ROLE_KEY) and skips that check.
SUPABASE_KEY=sb_publishable_xxx
DINO_DB_SECRET=long-random-string

ADMIN_PASSWORD=choose-a-password
SESSION_SECRET=any-long-random-string
