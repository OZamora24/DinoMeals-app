# Copy to .env.local for local testing, and add the same values in
# Vercel -> Project Settings -> Environment Variables.
# Leave SUPABASE_* empty to run in DEMO mode (sample data, nothing saved,
# admin password "dinodemo").

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key works: the database only answers when DINO_DB_SECRET matches
# the hash stored in private.app_secret (see RLS policies). A service-role key
# also works (SUPABASE_SERVICE_ROLE_KEY) and skips that check.
SUPABASE_KEY=sb_publishable_xxx
DINO_DB_SECRET=long-random-string

ADMIN_PASSWORD=choose-a-password
SESSION_SECRET=any-long-random-string

# Customer texts (Twilio). Leave SMS_ENABLED unset/false until Twilio shows the
# A2P 10DLC campaign as VERIFIED — then set SMS_ENABLED=true and redeploy.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# (or TWILIO_PHONE_NUMBER=+1909... if not using a Messaging Service)
SMS_ENABLED=false

# Weekly cutoff-reminder texts (Vercel Cron calls /api/cron/reminder on Thursdays).
# Any long random string; Vercel sends it automatically to cron requests.
CRON_SECRET=long-random-string

# Weekly sales report email (Monday 8 PM Pacific). Create a free account at resend.com, make an API key.
# RESEND_API_KEY=re_...
# REPORT_EMAIL_TO=dinomealsllc@gmail.com
# REPORT_FROM=DinoMeals Reports <reports@dinomeals.app>   (needs the domain verified in Resend; until then leave unset)
